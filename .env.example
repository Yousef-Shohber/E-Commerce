# Copy to .env (production) or .env.development (development).
# NEVER commit the real files. The values are validated (Zod) when the app starts.

# ---- database (PostgreSQL) ----
DATABASE_URL=postgres://user:password@localhost:5432/nest_shop

# ---- app ----
PORT=3000
# Public URL of the API (used as the Swagger server)
DOMAIN=http://localhost:3000

# ---- JWT ----
# Min 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
# A number + s, m, h or d
JWT_ACCESS_EXPIRES_IN=1d

# ---- one-time codes (OTP) ----
# Min 32 characters, used to hash the codes stored in Redis
OTP_SECRET=change-me-change-me-change-me-change-me
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ---- email (SMTP) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=change-me
# Optional. Default: SMTP_USERNAME
# MAIL_FROM="Nest Shop" <no-reply@example.com>

# ---- Google login ----
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ---- Cloudinary (profile images and product images) ----
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# ---- optional ----
# Requests per minute per IP for the whole API (every /auth route has its own, stricter, limit)
# THROTTLE_LIMIT=100
# THROTTLE_DISABLED=false

# Front-end origins allowed by CORS (comma separated).
# Not set: open in development, closed in production.
# CORS_ORIGINS=https://shop.example.com,https://admin.example.com

# Number of reverse proxies in front of the app (Vercel, Nginx...): the rate limit then uses the real client IP
# TRUST_PROXY=1
