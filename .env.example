# Copy to .env (production) or .env.development (development).
# NEVER commit the real files.

# ---- database (PostgreSQL) ----
DATABASE_URL=postgres://user:password@localhost:5432/nest_shop

# ---- app ----
PORT=3000
# Public URL of the API (used in the links inside emails and in Swagger)
DOMAIN=http://localhost:3000

# ---- JWT ----
# Use a long random value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# ---- email (SMTP) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=change-me
# Optional. Default: "Nest JS" <SMTP_USERNAME>
# MAIL_FROM="Nest JS" <no-reply@example.com>

# ---- Google login ----
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_CALLBACK_URL=http://localhost:3000/api/users/auth/google/callback

# ---- Cloudinary (profile images) ----
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# ---- optional ----
# Requests per minute per IP for the whole API (login/register/reset have their own, stricter, limit)
# THROTTLE_LIMIT=100
