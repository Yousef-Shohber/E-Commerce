# Paste a token from POST /api/v1/auth/login (never commit real tokens)
@token = PASTE_YOUR_TOKEN_HERE

### Get All Users
GET http://localhost:3000/api/v1/users
Authorization: Bearer {{token}}

### Get Single User 
GET http://localhost:3000/api/v1/users/current-user
Authorization: Bearer {{token}}

### Register
POST http://localhost:3000/api/v1/auth/register
Content-Type: application/json

{
  "email" : "Sonic@gmail.com",
  "password" : "Sonic123",
  "username" : "Shohber"
}

### Login
POST http://localhost:3000/api/v1/auth/login
Content-Type: application/json

{
  "email": "Sonic@gmail.com",
  "password" : "Sonic123"
}

### Verify email (the 6-digit code from the e-mail)
POST http://localhost:3000/api/v1/auth/verify-email
Content-Type: application/json

{ "email": "Sonic@gmail.com", "otp": "123456" }

### Resend the verification code
POST http://localhost:3000/api/v1/auth/resend-verification-otp
Content-Type: application/json

{ "email": "Sonic@gmail.com" }

### Forgot password (emails a code)
POST http://localhost:3000/api/v1/auth/forgot-password
Content-Type: application/json

{ "email": "Sonic@gmail.com" }

### Reset password
POST http://localhost:3000/api/v1/auth/reset-password
Content-Type: application/json

{ "email": "Sonic@gmail.com", "otp": "123456", "newPassword": "Sonic1234" }

### Change password
POST http://localhost:3000/api/v1/auth/change-password
Authorization: Bearer {{token}}
Content-Type: application/json

{ "currentPassword": "Sonic123", "newPassword": "Sonic1234" }
