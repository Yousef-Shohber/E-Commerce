# Paste a token from POST /api/v1/auth/login (never commit real tokens)
@token = PASTE_YOUR_TOKEN_HERE

### Get All Reviews
GET http://localhost:3000/api/v1/reviews?page=2&limit=1
Authorization: Bearer {{token}}

### Get Single Review
GET http://localhost:3000/api/v1/reviews/1
Authorization: Bearer {{token}}

### Create new Review
POST http://localhost:3000/api/v1/reviews/15
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rating": 2,
  "comment": "Bad product"
}

### Update Review
PUT http://localhost:3000/api/v1/reviews/6
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "rating": 5
}

### Delete Review
DELETE http://localhost:3000/api/v1/reviews/6
Authorization: Bearer {{token}}
